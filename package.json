{
  "name": "green-studio",
  "version": "3.1.0-beta.4",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser/media.e2e.cjs && node tests/browser/live.e2e.cjs && node tests/browser/app.e2e.cjs && node tests/browser/takes.e2e.cjs",
    "apk": "bash scripts/build-apk.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^3.0.0",
    "@mediapipe/tasks-vision": "0.10.21",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "mediabunny": "1.65.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
